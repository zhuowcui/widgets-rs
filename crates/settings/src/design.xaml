<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <x:Double x:Key="WidgetArtworkOpacity">1</x:Double>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#B8FFFFFF" Offset="0" />
                <GradientStop Color="#70F3F8FF" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#180F2944" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <x:Double x:Key="WidgetArtworkOpacity">1</x:Double>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
            <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#304A709A" Offset="0" />
                <GradientStop Color="#121A3554" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="CardStrokeColorDefaultBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#387CA8D5" Offset="0" />
                <GradientStop Color="#207CA8D5" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <x:Double x:Key="WidgetArtworkOpacity">0</x:Double>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style TargetType="Image">
        <Setter Property="Opacity" Value="{ThemeResource WidgetArtworkOpacity}" />
    </Style>
    <Style TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
    </Style>
    <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Left</HorizontalAlignment>
    <Style TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
        <Setter Property="DefaultButton" Value="Close" />
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
